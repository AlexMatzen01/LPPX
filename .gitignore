# Generated by Cargo
# Will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://rust-lang.org
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Used by cargo-mutants, a mutation testing tool
**/mutants.out*/

# Rustc internal compiler error stack dump files
rustc-ice-*.txt

# Shared library artifacts (cdylib builds)
*.so
*.dylib
*.dll

# LPPX2D/LPPX3D test output images
*.ppm
*.png

# IDE and editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Temporary build artifacts
*.o
*.a
